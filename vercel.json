{
    "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
    "outputDirectory": "frontend/dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://rag-chatbot-backend.onrender.com/api/:path*"
        },
        {
            "source": "/auth/:path*",
            "destination": "https://rag-chatbot-backend.onrender.com/auth/:path*"
        }
    ]
}