{
    "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
    "outputDirectory": "frontend/dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/((?!api|auth).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.py": {
            "runtime": "vercel-python@0.1.0"
        }
    }
}