{
    "version": 2,
    "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
    "outputDirectory": "frontend/dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/**/*.py": {
            "runtime": "@vercel/python"
        }
    }
}